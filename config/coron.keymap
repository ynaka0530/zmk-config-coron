/* coron.keymap */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    combos {
        compatible = "zmk,combos";

        /* Note: Key positions have shifted due to added columns. 
           You will need to recalculate these indices later. */

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        msc: msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "MSC";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC         &kp Q         &kp W         &kp E          &kp R        &kp T        &kp Y          &kp U        &kp I        &kp O      &kp P                 &kp BACKSPACE
&kp TAB         &kp A         &kp S         &kp D          &kp F        &kp G        &kp LS(LG(S))  &kp MINUS    &kp H        &kp J      &kp K                 &kp L          &kp SEMICOLON  &kp DELETE
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C          &kp V        &kp B        &kp COMMA      &kp DOT      &kp N        &kp M      &mkp MB1              &mkp MB3       &mkp MB2       &kp SINGLE_QUOTE
&kp LCTRL       &kp LEFT_ALT  &kp LEFT_WIN  &kp BACKSPACE  &lt 2 SPACE  &lt 3 ENTER  &mo 1          &lt 3 LANG2  &lt 2 LANG1  &kp SLASH  &kp NON_US_BACKSLASH
            >;

            sensor-bindings = <&msc MOVE_Y(20)>;
        };

        FUNCTION {
            bindings = <
&none  &none   &none   &none   &none   &none   &none  &none   &none   &none   &none   &none
&none  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&none  &none   &none   &none   &none   &none   &none  &none   &none   &none   &none   &none    &none    &none
&none  &none   &none   &none   &none   &none   &none  &none   &none   &none   &none
            >;

            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>;
        };

        NUM {
            bindings = <
&kp EQUAL      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none       &kp UP  &none     &none           &none      &none
&none          &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &none       &none   &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp RIGHT_SHIFT  &none  &none
&none          &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT  &none   &none     &none           &none      &none            &none  &none
&kp BACKSLASH  &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_NUMBER_0  &none            &none            &none       &none   &none     &none           &none
            >;
        };

        ARROW {
            bindings = <
&none                 &none                  &none  &kp LS(N7)        &kp LS(N8)        &kp LS(NON_US_BACKSLASH)  &none  &none  &none  &kp UP_ARROW  &none     &none
&kp LEFT_BRACE        &kp RIGHT_BRACE        &none  &kp LS(NUMBER_4)  &kp LS(N5)        &kp LS(NUMBER_6)          &none  &none  &none  &none         &kp LEFT  &kp DOWN  &kp RIGHT  &none
&kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)          &none  &none  &none  &none         &none     &none     &none      &none
&kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none  &none             &none             &none                     &none  &none  &none  &none         &none
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &bootloader   &trans        &trans          &trans  &trans  &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
            >;
        };
    };
};
